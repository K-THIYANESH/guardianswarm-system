# GUARDIAN SWARM CONFIGURATION VARIABLES

# Hugging Face checkpoints to download / load
GUARDIAN_MODEL_NAME=microsoft/Phi-3.5-mini-instruct
GUARDIAN_FALLBACK_MODEL_NAME=HuggingFaceTB/SmolLM2-1.7B-Instruct

# Local folder where models are stored
GUARDIAN_CACHE_DIR=./models

# Device usage
GUARDIAN_USE_CUDA=True

# Force Heuristics Rules Engine (useful for running offline or quickly testing)
GUARDIAN_FORCE_HEURISTICS=False

# Generation parameters
GUARDIAN_MAX_NEW_TOKENS=150
GUARDIAN_TEMPERATURE=0.2
GUARDIAN_DO_SAMPLE=True
GUARDIAN_REPETITION_PENALTY=1.1
